# Optional live discovery connectors. Leave a key blank to show that provider as
# "credentials required" in the scan report.
YOUTUBE_API_KEY=
VIMEO_ACCESS_TOKEN=
X_BEARER_TOKEN=

# Reddit OAuth application credentials for public post search.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:relay-rights-monitor:1.0

# Cross-platform web index. The included local SearXNG service is recommended.
SEARXNG_URL=http://localhost:8080
SEARXNG_TOKEN=

# Optional legacy Google Programmable Search fallback. Google has closed the
# JSON API to new customers and plans to discontinue it on January 1, 2027.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Local Faster-Whisper + yt-dlp source transcription worker.
TRANSCRIPTION_WORKER_URL=http://localhost:8788
TRANSCRIPTION_WORKER_TOKEN=relay-local-development
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
